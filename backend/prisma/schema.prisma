generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  steam_app_id Int?      @unique
  image        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime?

  @@index([name])
  @@map("games")
}
